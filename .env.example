# Copy to .env.local and fill in. Never commit .env.local.
# Supabase dashboard → Project Settings → API Keys.
#
# Without the Supabase values, the public site shows the built-in room data
# and, in development only, the admin runs on clearly-labelled preview data.
#
# ENVIRONMENTS — use a DIFFERENT Supabase project per environment:
#   local dev     → `npm run db:start` (local stack) or a staging project
#   Vercel Preview→ staging project
#   Vercel Prod   → production project (sbzwlizkllzjpbqjhued)
# See docs/MIGRATION_AND_ROLLBACK.md.

# ---- Public (inlined into browser JavaScript; RLS protects the data) ----
NEXT_PUBLIC_SUPABASE_URL=
# New-style key: sb_publishable_…  (preferred)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon JWT — only read if the publishable key above is empty. Remove once migrated.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the site, used in staff invite and password-reset emails.
# http://localhost:3000 locally; https://blossomsquare.online in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Server only (NEVER prefix with NEXT_PUBLIC_; the build fails if you do) ----
# New-style key: sb_secret_…  Bypasses RLS. Used to invite/manage staff, to
# send queued guest messages, and to record verified gateway payments.
# On Vercel add it as a "Sensitive" variable.
SUPABASE_SECRET_KEY=
# Legacy service_role JWT — only read if SUPABASE_SECRET_KEY is empty.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Payments & guest messaging (all server only, all optional) ----------
# Anything left empty shows as "Not set up" in the admin; see
# docs/PAYMENTS_AND_MESSAGING.md. Add each as "Sensitive" on Vercel.
#
# Scheduled sweep of the message queue (/api/jobs/messages). A long random string.
CRON_SECRET=
#
# Email (Resend, https://resend.com) — EMAIL_FROM must be on a verified domain.
RESEND_API_KEY=
EMAIL_FROM=Blossom Square <bookings@blossomsquare.online>
EMAIL_REPLY_TO=
# Webhook signing secret (whsec_…) for delivery / bounce tracking → /api/webhooks/email
RESEND_WEBHOOK_SECRET=
#
# WhatsApp Business Platform (Cloud API). Templates must be approved first.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_BOOKING_CONFIRMATION=
WHATSAPP_TEMPLATE_BOOKING_MODIFICATION=
WHATSAPP_TEMPLATE_BOOKING_CANCELLATION=
WHATSAPP_TEMPLATE_PRE_ARRIVAL=
WHATSAPP_TEMPLATE_PAYMENT_CONFIRMATION=
#
# Card payments (SSLCommerz). Test with SSLCOMMERZ_SANDBOX=true first.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
#
# bKash tokenized checkout. Sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# ---- Optional ----
# Comma-separated LAN origins allowed to load dev assets (phone testing).
# DEV_LAN_ORIGINS=192.168.0.29
