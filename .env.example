# Copy to .env.local and fill in from Supabase → Project Settings → API.
#
# Without these, the public site shows the built-in room data and, in
# development only, the admin runs on clearly-labelled preview data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Needed for inviting staff from Admin → Settings → Team.
# Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site, used in staff invite and password-reset emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
