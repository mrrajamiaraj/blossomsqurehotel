// Generates supabase/rollbacks/20261118230000_payments_and_messaging.down.sql by
// comparing a database migrated up to the CMS & operations release with one
// that also has the payments & messaging migration: changed functions are
// restored to their previous definitions and privileges; new functions,
// tables, columns, constraints, triggers, sequences and jobs are undone.
// `npx tsx scripts/gen-payments-rollback.mts` — verified by tests/db/payments-rollback.test.ts.
import { writeFileSync } from "node:fs";
import { createDevDatabase, type Db } from "../tests/db/harness";

const PREVIOUS = "20261118180000_cms_and_operations.sql";
const RELEASE = "20261118230000_payments_and_messaging.sql";
const OUT = "supabase/rollbacks/20261118230000_payments_and_messaging.down.sql";

type Fn = { sig: string; def: string; src: string; acl: string[] };

async function functions(db: Db): Promise<Map<string, Fn>> {
  const { rows } = await db.query<{ sig: string; def: string; src: string; acl: string[] | null }>(`
    select format('public.%I(%s)', p.proname, pg_get_function_identity_arguments(p.oid)) as sig,
           pg_get_functiondef(p.oid) as def, p.prosrc as src,
           (select array_agg(r.rolname order by r.rolname) from (values ('anon'), ('authenticated'), ('service_role')) r(rolname)
             where has_function_privilege(r.rolname, p.oid, 'execute')) as acl
    from pg_proc p where p.pronamespace = 'public'::regnamespace and p.prokind = 'f'`);
  return new Map(rows.map((r) => [r.sig, { ...r, acl: r.acl ?? [] }]));
}

const [before, after] = await Promise.all([createDevDatabase({ upTo: PREVIOUS }), createDevDatabase({ upTo: RELEASE })]);
const oldFns = await functions(before);
const newFns = await functions(after);

const out: string[] = [];
out.push(`-- ROLLBACK for ${RELEASE} (generated by scripts/gen-payments-rollback.mts).
-- Restores every function the release replaced (definition and EXECUTE rights)
-- and removes what it added. Run in one transaction:
--   psql "$DB_URL" -v ON_ERROR_STOP=1 -1 -f supabase/rollbacks/20261118230000_payments_and_messaging.down.sql
-- then delete the migration's row from supabase_migrations.schema_migrations.
--
-- DATA:
--   * Payments keep their amount, method, status and reference. Receipt and
--     invoice numbers, verification details and the guest's "sent from" note
--     are dropped. Transfers still awaiting verification stay "pending"
--     (never counted as paid); verify or void them first if you can.
--   * The message outbox and its delivery history, WhatsApp consents, gateway
--     notification records and invoices are dropped.
`);

out.push(`/* ---------- scheduled jobs ---------- */

do $$
begin
  perform cron.unschedule('bsq-payment-intents');
  perform cron.unschedule('bsq-pre-arrival');
exception when others then
  raise notice 'No payment/messaging jobs to remove: %', sqlerrm;
end;
$$;

/* ---------- triggers that call the release's functions ---------- */

drop trigger if exists booking_events_messages on public.booking_events;
drop trigger if exists payments_messages on public.payments;
drop trigger if exists payments_receipt_no on public.payments;
drop trigger if exists payment_intents_messages on public.payment_intents;
drop trigger if exists inquiries_messages on public.inquiries;
`);

// 1. Restore changed functions (before dropping anything they may call).
const restored = [...newFns.values()].filter((f) => oldFns.has(f.sig) && (oldFns.get(f.sig)!.src !== f.src || oldFns.get(f.sig)!.acl.join() !== f.acl.join()));
out.push("/* ---------- functions restored to their previous definitions ---------- */\n");
for (const f of restored) {
  const old = oldFns.get(f.sig)!;
  if (old.src !== f.src) out.push(`${old.def.trim()};\n`);
}

// 2. Drop the release's own functions.
out.push("/* ---------- functions added by the release ---------- */\n");
for (const f of newFns.values()) if (!oldFns.has(f.sig)) out.push(`drop function if exists ${f.sig};`);

// 3. Tables, columns, constraints, sequences.
out.push(`
/* ---------- tables, columns, constraints, sequences ---------- */

drop table if exists public.message_events;
drop table if exists public.message_outbox;
drop table if exists public.webhook_receipts;
drop table if exists public.messaging_consents;
drop table if exists public.invoices;
drop table if exists public.payment_gateway_events;

drop index if exists public.payments_txn_once;
alter table public.payments
  drop column if exists receipt_no, drop column if exists verified_at, drop column if exists verified_by,
  drop column if exists review_note, drop column if exists sender, drop column if exists source;

alter table public.payment_intents drop column if exists expires_at;

alter table public.hotel_settings drop constraint if exists hotel_settings_payment_methods;
alter table public.hotel_settings drop column if exists payment_methods;

drop sequence if exists public.payment_receipt_seq;
drop sequence if exists public.invoice_seq;
`);

// 4. EXECUTE rights exactly as before.
out.push("/* ---------- EXECUTE rights as before ---------- */\n");
for (const f of restored) {
  const old = oldFns.get(f.sig)!;
  out.push(`revoke all on function ${f.sig} from public, anon, authenticated, service_role;`);
  if (old.acl.length) out.push(`grant execute on function ${f.sig} to ${old.acl.join(", ")};`);
}

writeFileSync(OUT, `${out.join("\n")}\n`);
console.log(`Wrote ${OUT}: ${restored.length} functions restored, ${[...newFns.keys()].filter((k) => !oldFns.has(k)).length} dropped`);
await Promise.all([before.close(), after.close()]);
