// Generates supabase/rollbacks/20261118180000_cms_and_operations.down.sql by
// comparing a database migrated up to the booking engine with one that also
// has the CMS & operations migration: changed functions are restored to their
// previous definitions and privileges; new functions, tables, columns,
// constraints, triggers and grants are undone.
// `npx tsx scripts/gen-cms-rollback.mts` — verified by tests/db/cms-rollback.test.ts.
import { writeFileSync } from "node:fs";
import { createDevDatabase, type Db } from "../tests/db/harness";

const PREVIOUS = "20261118120000_booking_engine.sql";
const RELEASE = "20261118180000_cms_and_operations.sql";
const OUT = "supabase/rollbacks/20261118180000_cms_and_operations.down.sql";

type Fn = { sig: string; def: string; src: string; acl: string[] };

async function functions(db: Db): Promise<Map<string, Fn>> {
  const { rows } = await db.query<{ sig: string; def: string; src: string; acl: string[] | null }>(`
    select format('public.%I(%s)', p.proname, pg_get_function_identity_arguments(p.oid)) as sig,
           pg_get_functiondef(p.oid) as def, p.prosrc as src,
           (select array_agg(r.rolname order by r.rolname) from (values ('anon'), ('authenticated'), ('service_role')) r(rolname)
             where has_function_privilege(r.rolname, p.oid, 'execute')) as acl
    from pg_proc p where p.pronamespace = 'public'::regnamespace and p.prokind = 'f'`);
  return new Map(rows.map((r) => [r.sig, { ...r, acl: r.acl ?? [] }]));
}

const [before, after] = await Promise.all([createDevDatabase({ upTo: PREVIOUS }), createDevDatabase({ upTo: RELEASE })]);
const oldFns = await functions(before);
const newFns = await functions(after);

const out: string[] = [];
out.push(`-- ROLLBACK for ${RELEASE} (generated by scripts/gen-cms-rollback.mts).
-- Restores every function the release replaced (definition and EXECUTE rights)
-- and removes what it added. Run in one transaction:
--   psql "$DB_URL" -v ON_ERROR_STOP=1 -1 -f supabase/rollbacks/20261118180000_cms_and_operations.down.sql
-- then delete the migration's row from supabase_migrations.schema_migrations.
--
-- DATA:
--   * Unpublished drafts of sections that were published are dropped (the live
--     text stays). Never-published drafts become the old "draft" rows again.
--   * Content version history, the media library records and the per-booking
--     offer breakdown are dropped. Uploaded files stay in Storage; bookings keep
--     their total, discount and main offer.
--   * Rooms marked "cleaning" go back to "dirty".
--   * Automatic (no-code) offers stop applying; the previous engine only
--     knows codes.
`);

out.push(`/* ---------- data the previous schema can't hold ---------- */

update public.rooms set housekeeping = 'dirty' where housekeeping = 'cleaning';
update public.site_content set body = coalesce(draft_body, body), title = coalesce(draft_title, title) where status = 'draft';
`);

// 1. Restore changed functions (before dropping anything they may call).
const restored = [...newFns.values()].filter((f) => oldFns.has(f.sig) && (oldFns.get(f.sig)!.src !== f.src || oldFns.get(f.sig)!.acl.join() !== f.acl.join()));
out.push("/* ---------- functions restored to their previous definitions ---------- */\n");
for (const f of restored) {
  const old = oldFns.get(f.sig)!;
  if (old.src !== f.src) out.push(`${old.def.trim()};\n`);
}

// 2. Drop the release's own functions.
out.push("/* ---------- functions added by the release ---------- */\n");
for (const f of newFns.values()) if (!oldFns.has(f.sig)) out.push(`drop function if exists ${f.sig};`);

// 3. Tables, triggers, constraints, columns and grants.
out.push(`
/* ---------- tables, triggers, constraints, columns ---------- */

drop trigger if exists audit_amenities on public.amenities;
drop trigger if exists audit_room_type_amenities on public.room_type_amenities;
drop table if exists public.booking_promotions;
drop table if exists public.media_assets;
drop table if exists public.site_content_versions;

alter table public.rooms drop constraint if exists rooms_housekeeping_check;
alter table public.rooms add constraint rooms_housekeeping_check check (housekeeping in ('clean', 'dirty', 'inspected'));

alter table public.hotel_settings drop column if exists max_discount_percent;

alter table public.promotions drop constraint if exists promotions_code_or_auto;
alter table public.promotions drop constraint if exists promotions_booking_window;
alter table public.promotions drop constraint if exists promotions_amount_max;
alter table public.promotions
  drop column if exists bookable_until, drop column if exists bookable_from, drop column if exists max_discount_bdt,
  drop column if exists auto_apply, drop column if exists stackable;

alter table public.site_content drop constraint if exists site_content_size;
alter table public.site_content drop constraint if exists site_content_draft_object;
alter table public.site_content drop constraint if exists site_content_body_object;
alter table public.site_content
  drop column if exists version, drop column if exists draft_updated_by, drop column if exists draft_updated_at,
  drop column if exists draft_body, drop column if exists draft_title;

/* ---------- table privileges as before ---------- */

revoke all on public.site_content from anon, authenticated;
grant select on public.site_content to anon;
grant select, insert, update, delete on public.site_content to authenticated;
grant insert, update, delete on public.promotions to authenticated;
`);

// 4. EXECUTE rights exactly as before.
out.push("/* ---------- EXECUTE rights as before ---------- */\n");
for (const f of restored) {
  const old = oldFns.get(f.sig)!;
  out.push(`revoke all on function ${f.sig} from public, anon, authenticated, service_role;`);
  if (old.acl.length) out.push(`grant execute on function ${f.sig} to ${old.acl.join(", ")};`);
}

writeFileSync(OUT, `${out.join("\n")}\n`);
console.log(`Wrote ${OUT}: ${restored.length} functions restored, ${[...newFns.keys()].filter((k) => !oldFns.has(k)).length} dropped`);
await Promise.all([before.close(), after.close()]);
