// Generates supabase/rollbacks/20261118120000_booking_engine.down.sql by
// comparing a database migrated up to the release before the booking engine
// with one that includes it: functions are restored to their previous
// definitions and privileges, new functions/tables/columns are dropped.
// `npx tsx scripts/gen-engine-rollback.mts` — verified by tests/db/engine-rollback.test.ts.
import { writeFileSync } from "node:fs";
import { createDevDatabase, type Db } from "../tests/db/harness";

const PREVIOUS = "20261117204245_storage.sql";
const OUT = "supabase/rollbacks/20261118120000_booking_engine.down.sql";

type Fn = { sig: string; def: string; src: string; acl: string[] };

async function functions(db: Db): Promise<Map<string, Fn>> {
  const { rows } = await db.query<{ sig: string; def: string; src: string; acl: string[] | null }>(`
    select format('public.%I(%s)', p.proname, pg_get_function_identity_arguments(p.oid)) as sig,
           pg_get_functiondef(p.oid) as def, p.prosrc as src,
           (select array_agg(r.rolname order by r.rolname) from (values ('anon'), ('authenticated'), ('service_role')) r(rolname)
             where has_function_privilege(r.rolname, p.oid, 'execute')) as acl
    from pg_proc p where p.pronamespace = 'public'::regnamespace and p.prokind = 'f'`);
  return new Map(rows.map((r) => [r.sig, { ...r, acl: r.acl ?? [] }]));
}

const [before, after] = await Promise.all([createDevDatabase({ upTo: PREVIOUS }), createDevDatabase()]);
const oldFns = await functions(before);
const newFns = await functions(after);

const out: string[] = [];
out.push(`-- ROLLBACK for 20261118120000_booking_engine.sql (generated by scripts/gen-engine-rollback.mts).
-- Restores every function the engine replaced (definition and EXECUTE rights),
-- drops the engine's functions, tables and columns. Run in one transaction:
--   psql "$DB_URL" -v ON_ERROR_STOP=1 -1 -f supabase/rollbacks/20261118120000_booking_engine.down.sql
-- then delete the migration's row from supabase_migrations.schema_migrations.
--
-- DATA: holds, guest access tokens, booking requests and payment intents are
-- dropped; per-booking price breakdowns and payment options are dropped.
-- Refuses to run while any reservation mixes room types (the previous schema
-- can't represent it), or any online payment exists.

do $$
begin
  if exists (select 1 from public.booking_rooms br join public.bookings b on b.id = br.booking_id
             where br.room_type_id <> b.room_type_id) then
    raise exception 'rollback: some reservations mix room types; change them to one type first';
  end if;
  if exists (select 1 from public.payments where method = 'online') then
    raise exception 'rollback: online payments exist; they would lose their method';
  end if;
end;
$$;

do $$
begin
  perform cron.unschedule('bsq-booking-expiry');
exception when others then
  null;  -- pg_cron absent or job not scheduled
end;
$$;
`);

// 1. Restore changed functions (before dropping anything they may call).
const restored = [...newFns.values()].filter((f) => oldFns.has(f.sig) && (oldFns.get(f.sig)!.src !== f.src || oldFns.get(f.sig)!.acl.join() !== f.acl.join()));
out.push("/* ---------- functions restored to their previous definitions ---------- */\n");
for (const f of restored) {
  const old = oldFns.get(f.sig)!;
  if (old.src !== f.src) out.push(`${old.def.trim()};\n`);
}

// 2. Drop the engine's own functions.
out.push("/* ---------- functions added by the engine ---------- */\n");
for (const f of newFns.values()) if (!oldFns.has(f.sig)) out.push(`drop function if exists ${f.sig};`);

// 3. Tables, constraints, columns.
out.push(`
/* ---------- tables, constraints and columns ---------- */

alter table public.payments drop constraint if exists payments_intent_fkey;
alter table public.bookings drop constraint if exists bookings_hold_fkey;
drop table if exists public.payment_intents;
drop table if exists public.booking_requests;
drop table if exists public.booking_access_tokens;
drop table if exists public.booking_hold_rooms;
drop table if exists public.booking_holds;

drop index if exists public.payments_intent_once;
alter table public.payments drop column if exists intent_id;
alter table public.payments drop constraint if exists payments_method_check;
alter table public.payments add constraint payments_method_check check (method in ('cash', 'bkash', 'nagad', 'card', 'bank', 'other'));

drop index if exists public.promotions_code_ci;
alter table public.promotions drop column if exists max_redemptions;

drop index if exists public.booking_rooms_inventory_idx;
alter table public.booking_rooms
  drop column if exists line_no, drop column if exists price_detail,
  drop column if exists subtotal_bdt, drop column if exists rate_plan_id;

alter table public.bookings
  drop column if exists price_detail, drop column if exists hold_id, drop column if exists idempotency_key,
  drop column if exists payment_due_at, drop column if exists advance_due_bdt, drop column if exists payment_option,
  drop column if exists vat_bdt, drop column if exists service_charge_bdt, drop column if exists discount_bdt,
  drop column if exists subtotal_bdt;

alter table public.hotel_settings
  drop column if exists hold_minutes, drop column if exists advance_due_hours, drop column if exists advance_percent;
`);

// 4. EXECUTE rights exactly as before.
out.push("/* ---------- EXECUTE rights as before ---------- */\n");
for (const f of restored) {
  const old = oldFns.get(f.sig)!;
  out.push(`revoke all on function ${f.sig} from public, anon, authenticated, service_role;`);
  if (old.acl.length) out.push(`grant execute on function ${f.sig} to ${old.acl.join(", ")};`);
}

writeFileSync(OUT, `${out.join("\n")}\n`);
console.log(`Wrote ${OUT}: ${restored.length} functions restored, ${[...newFns.keys()].filter((k) => !oldFns.has(k)).length} dropped`);
await Promise.all([before.close(), after.close()]);
